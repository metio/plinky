# Anonymous usage analytics (optional). Leave it unset and the app never loads a
# measurement script and never sends anything — the Settings opt-in has nothing to
# turn on. Copy this file to `.env.local` (gitignored) to set it locally.
# VITE_ANALYTICS_ID=G-XXXXXXXXXX
